{
  "$schema": "https://raw.githubusercontent.com/khouwdevin/cyberpunk-oh-my-posh/main/cyberpunk.omp.json",
  "final_space": true,
  "version": 3,
  "console_title_template": "{{ .Shell }} in {{ .UserName }}",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#eaff00",
          "style": "plain",
          "template": "\u256d\u2500|",
          "type": "text"
        },
        {
          "foreground": "#00eaff",
          "style": "plain",
          "properties": {
            "max_depth": 2,
            "style": "agnoster_short"
          },
          "template": " \ue5ff {{ .Path }}",
          "type": "path"
        },
        {
          "foreground": "#ffa600",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "properties": {
            "branch_max_length": 25,
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true,
            "fetch_bare_info": true,
            "branch_icon": "\ue0a0 ",
            "branch_identical_icon": "\u2261",
            "branch_ahead_icon": "\u2191",
            "branch_behind_icon": "\u2193",
            "branch_gone_icon": "\u2262",
            "commit_icon": "\uf417 ",
            "tag_icon": "\uf412 ",
            "merge_icon": "\ue727 ",
            "rebase_icon": "\ue728 ",
            "cherry_pick_icon": "\ue29b ",
            "revert_icon": "\uf0e2 ",
            "no_commits_icon": "\uf0c3 ",
            "stash_count_icon": "\uf692 ",
            "worktree_count_icon": "\uf1bb ",
            "github_icon": "\uf408 ",
            "gitlab_icon": "\uf296 ",
            "bitbucket_icon": "\uf171 ",
            "azure_devops_icon": "\uebe8 ",
            "git_icon": "\ue702 "
          },
          "style": "plain",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .LatestTag }} \uf412 {{ .LatestTag }}{{ end }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .UpstreamGone }} \u2262{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf692 {{ .StashCount }}{{ end }}{{ if gt .WorktreeCount 0 }} \uf1bb {{ .WorktreeCount }}{{ end }}",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "foreground": "#00ff62",
          "properties": {
            "time_format": "Mon, 02 Jan 2006 03:04 PM"
          },
          "style": "plain",
          "template": "",
          "type": "time"
        },
        {
          "background": "#29315A",
          "foreground": "#7FD5EA",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "Welcome {{ .UserName }}",
          "trailing_diamond": "\ue0b4",
          "type": "text"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#E06C75",
          "style": "plain",
          "template": "\u2570\u2500|",
          "type": "text"
        },
        {
          "foreground": "#ff0015",
          "style": "plain",
          "template": "",
          "type": "exit"
        }
      ],
      "type": "prompt"
    }
  ],
  "valid_line": {
    "background": "transparent",
    "foreground": "#ffffff",
    "template": ""
  },
  "error_line": {
    "background": "transparent",
    "foreground": "#ffffff",
    "template": ""
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#00ff62",
    "template": "+> "
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "#00ff62",
    "template": "=> "
  }
}
